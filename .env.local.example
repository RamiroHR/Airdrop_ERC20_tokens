# =============================================================================
# ENVIRONMENT SETUP GUIDE
# =============================================================================
#
# 1. Copy this file to create your environment-specific file:
#    cp .env.local.example .env.local          # For local development
#    cp .env.local.example .env.development    # For testnet deployment
#    cp .env.local.example .env.production     # For mainnet deployment
#
# 2. Fill in the values for YOUR environment (see sections below)
# 3. Delete or comment out sections you don't need
#
# =============================================================================

# =============================================================================
# REQUIRED FOR ALL ENVIRONMENTS
# =============================================================================

# Your deployed contract addresses
# Get these from: npx hardhat ignition deploy ignition/modules/Airdrop.js
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AIRDROP_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# LOCAL DEVELOPMENT ONLY (.env.local)
# =============================================================================
# Keep this section for local development, delete for testnet/mainnet

# Local Hardhat network (already set in .env, no changes needed)
# NEXT_PUBLIC_NETWORK_NAME=Hardhat Local
# NEXT_PUBLIC_CHAIN_ID=31337

# =============================================================================
# TESTNET DEPLOYMENT ONLY (.env.development)
# =============================================================================
# Keep this section for testnet deployment, delete for local/mainnet

# Testnet RPC URL (get from https://infura.io or https://alchemy.com)
# SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID_HERE

# Your wallet private key for deployment (NEVER commit this!)
# PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Etherscan API key for contract verification
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# =============================================================================
# MAINNET DEPLOYMENT ONLY (.env.production)
# =============================================================================
# Keep this section for mainnet deployment, delete for local/testnet

# Mainnet RPC URL (get from https://infura.io or https://alchemy.com)
# MAINNET_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID_HERE

# Your wallet private key for deployment (NEVER commit this!)
# PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Etherscan API key for contract verification
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# =============================================================================
# SECURITY REMINDERS
# =============================================================================
# ⚠️  Never commit your .env.local, .env.development, or .env.production files
# ⚠️  Keep your private key secure and never share it
# ⚠️  Only use the sections you need for your current environment
