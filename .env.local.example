# Use this file as template to create your .env.local, .env.development or .env.production file
# Then fill in your actual values

# =============================================================================
# LOCAL DEVELOPMENT (Hardhat Local Network)
# =============================================================================

# Your deployed contract addresses on local Hardhat network
# Get these from: npx hardhat ignition deploy ignition/modules/Airdrop.js --dry-run

# Deployed Smart Contracts
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AIRDROP_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# TESTNET/MAINNET DEPLOYMENT (Only needed for .env.development/.env.production)
# =============================================================================

# Infura/Alchemy URLs (get from https://infura.io or https://alchemy.com)
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID_HERE
MAINNET_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID_HERE

# Your wallet private key (for deployment)
# WARNING: Never commit or share your real private key!
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Etherscan API key (for contract verification)
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE